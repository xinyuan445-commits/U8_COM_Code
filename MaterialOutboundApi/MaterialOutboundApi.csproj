<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <RootNamespace>MaterialOutboundApi</RootNamespace>
    <AssemblyName>MaterialOutboundApi</AssemblyName>
    <Version>1.4.8</Version>
    <AssemblyVersion>1.4.8.0</AssemblyVersion>
    <FileVersion>1.4.8.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeneralInventoryCount\GeneralInventoryCount.csproj" />
    <ProjectReference Include="..\GeneralMaterialOutbound\GeneralMaterialOutbound.csproj" />
    <ProjectReference Include="..\MaterialOutboundConsole\MaterialOutboundConsole.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Dapper" Version="1.50.5" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebApi.WebHost" Version="5.2.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Swashbuckle.Core" Version="5.6.0" />
    <PackageReference Include="Swashbuckle.Examples" Version="4.1.0" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Interop.MSXML2">
      <HintPath>..\MaterialOutboundConsole\lib\Interop.MSXML2.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.USERPCO">
      <HintPath>..\MaterialOutboundConsole\lib\Interop.USERPCO.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="adodb">
      <HintPath>..\MaterialOutboundConsole\lib\adodb.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Interop.VBA">
      <HintPath>..\MaterialOutboundConsole\lib\Interop.VBA.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.Scripting">
      <HintPath>..\MaterialOutboundConsole\lib\Interop.Scripting.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="Interop.USCOMMON">
      <HintPath>..\MaterialOutboundConsole\lib\Interop.USCOMMON.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- This standalone script compiles its COM helper on the U8 server. -->
    <Compile Remove="Deployment\OtherVoucherPriceEngine.cs" />
    <Compile Remove="Deployment\OtherVoucherAmountEngine.cs" />
    <Compile Remove="Deployment\OtherVoucherLinePriceEngine.cs" />
    <Content Include="Edit-U8OtherVoucherLinePrice.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Import-U8InventoryCountExcel.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Clear-U8OtherVoucherPriceMemos.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Repair-U8OtherVoucherAmounts.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Update-U8OtherVoucherPrices.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Global.asax">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="Edit-U8InventoryCount.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Web.config">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\MaterialOutboundConsole\XML\head.xml" Link="XML\head.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\MaterialOutboundConsole\XML\body.xml" Link="XML\body.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ShapeConversionXml\head.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ShapeConversionXml\body.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md">
      <Link>API-README.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\GeneralMaterialOutbound\README.md">
      <Link>GENERAL-MATERIAL-OUTBOUND-API.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\GeneralInventoryCount\README.md">
      <Link>GENERAL-INVENTORY-COUNT-API.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
