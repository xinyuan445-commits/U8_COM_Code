<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <add name="U8Database"
         connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=YOUR_U8_DATABASE;User ID=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=False;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="U8SubId" value="YOUR_U8_SUBID" />
    <add key="U8AccId" value="YOUR_U8_ACCOUNT" />
    <add key="U8Year" value="YOUR_U8_YEAR" />
    <add key="U8UserId" value="YOUR_U8_USER" />
    <add key="U8Password" value="YOUR_U8_PASSWORD" />
    <add key="U8Date" value="YOUR_U8_DATE" />
    <add key="U8Server" value="YOUR_U8_SERVER" />
    <add key="U8Serial" value="YOUR_U8_SERIAL" />

    <!-- 按目标账套填写；不要把生产密码或密钥提交到 Git。 -->
    <add key="WarehouseCode" value="YOUR_WAREHOUSE_CODE" />
    <add key="DepartmentCode" value="YOUR_DEPARTMENT_CODE" />
    <add key="Maker" value="YOUR_MAKER" />
    <add key="WorkCenterCode" value="YOUR_WORK_CENTER_CODE" />
    <add key="DefaultPositionCode" value="YOUR_POSITION_CODE" />
    <add key="DefaultBatchCode" value="YOUR_BATCH_CODE" />
    <add key="DefaultUnitCost" value="0" />
  </appSettings>
</configuration>
